local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local Camera      = workspace.CurrentCamera

local Config = {
    ESP     = { Enabled = true,  MaxDistance = 800 },
    Speed   = { Enabled = false, Value = 50, Default = 16 },
    Fly     = { Enabled = false, Speed = 60 },
    SpinBot = { Enabled = false, Speed = 20 },
}

local RoleColors = {
    Murder   = Color3.fromRGB(255, 50,  50),
    Sheriff  = Color3.fromRGB(50,  140, 255),
    Hero     = Color3.fromRGB(255, 210, 0),
    Innocent = Color3.fromRGB(50,  220, 100),
}

local function GetRoleByInventory(player)
    local containers = {}
    if player.Character then table.insert(containers, player.Character) end
    local bp = player:FindFirstChildOfClass("Backpack")
    if bp then table.insert(containers, bp) end
    for _, container in ipairs(containers) do
        for _, item in ipairs(container:GetChildren()) do
            local name = item.Name:lower()
            if name:find("knife") or name:find("blade") or name:find("murder") then return "Murder" end
            if name:find("gun") or name:find("sheriff") or name:find("pistol") then return "Sheriff" end
            if name:find("hero") then return "Hero" end
        end
    end
    return "Innocent"
end

local ESPObjects = {}

local function NewLine()
    local l = Drawing.new("Line")
    l.Thickness = 1.2
    l.Visible   = false
    l.ZIndex    = 3
    return l
end

local function NewText(size)
    local t = Drawing.new("Text")
    t.Size    = size or 11
    t.Center  = true
    t.Outline = true
    t.Visible = false
    t.ZIndex  = 4
    return t
end

local function BuildESP(player)
    if player == LocalPlayer then return end
    ESPObjects[player] = {
        L1=NewLine(), L2=NewLine(), L3=NewLine(), L4=NewLine(),
        Name=NewText(12), Role=NewText(11), Dist=NewText(10),
    }
end

local function DestroyESP(player)
    local t = ESPObjects[player]
    if not t then return end
    for _, d in pairs(t) do d:Remove() end
    ESPObjects[player] = nil
end

local function HideAll(t)
    for _, d in pairs(t) do d.Visible = false end
end

local function GetBBox(char)
    local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
    local hit = false
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            local s, d = Camera:WorldToScreenPoint(p.Position)
            if d > 0 then
                hit = true
                if s.X < minX then minX = s.X end
                if s.Y < minY then minY = s.Y end
                if s.X > maxX then maxX = s.X end
                if s.Y > maxY then maxY = s.Y end
            end
        end
    end
    if not hit then return nil end
    return minX-4, minY-4, maxX+4, maxY+4
end

local function UpdateESP()
    for player, t in pairs(ESPObjects) do
        if not Config.ESP.Enabled then HideAll(t) continue end
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not (char and root and hum and hum.Health > 0) then HideAll(t) continue end
        local lRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local dist  = lRoot and (root.Position - lRoot.Position).Magnitude or 0
        if dist > Config.ESP.MaxDistance then HideAll(t) continue end
        local x1, y1, x2, y2 = GetBBox(char)
        if not x1 then HideAll(t) continue end
        local role  = GetRoleByInventory(player)
        local color = RoleColors[role]
        local cx    = (x1+x2)/2
        t.L1.From=Vector2.new(x1,y1) t.L1.To=Vector2.new(x2,y1)
        t.L2.From=Vector2.new(x2,y1) t.L2.To=Vector2.new(x2,y2)
        t.L3.From=Vector2.new(x2,y2) t.L3.To=Vector2.new(x1,y2)
        t.L4.From=Vector2.new(x1,y2) t.L4.To=Vector2.new(x1,y1)
        for i=1,4 do t["L"..i].Color=color t["L"..i].Visible=true end
        t.Name.Text=player.DisplayName t.Name.Position=Vector2.new(cx,y1-14)
        t.Name.Color=color t.Name.Visible=true
        t.Role.Text="["..role.."]" t.Role.Position=Vector2.new(cx,y2+2)
        t.Role.Color=color t.Role.Visible=true
        t.Dist.Text=string.format("%.0fm",dist) t.Dist.Position=Vector2.new(cx,y2+14)
        t.Dist.Color=Color3.fromRGB(190,190,190) t.Dist.Visible=true
    end
end

for _, p in ipairs(Players:GetPlayers()) do BuildESP(p) end
Players.PlayerAdded:Connect(BuildESP)
Players.PlayerRemoving:Connect(DestroyESP)

local function ApplySpeed(state)
    local char = LocalPlayer.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.WalkSpeed = state and Config.Speed.Value or Config.Speed.Default end
end

local FlyConn, Flying = nil, false

local function EnableFly()
    Flying = false
    if FlyConn then FlyConn:Disconnect() FlyConn = nil end

    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    Flying = true
    hum.PlatformStand = true

    local speed = Config.Fly.Speed
    local lastCF = root.CFrame

    FlyConn = RunService.Heartbeat:Connect(function(dt)
        if not Flying then return end
        local r = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not r then return end

        local cf   = Camera.CFrame
        local move = Vector3.zero

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + cf.LookVector  end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - cf.LookVector  end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - cf.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + cf.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space)       then move = move + Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move = move - Vector3.new(0,1,0) end

        if move.Magnitude > 0 then move = move.Unit end

        local newPos = r.CFrame.Position + move * Config.Fly.Speed * dt
        r.CFrame = CFrame.new(newPos) * (cf - cf.Position)
    end)
end

local function DisableFly()
    Flying = false
    if FlyConn then FlyConn:Disconnect() FlyConn = nil end
    local char = LocalPlayer.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand = false end
end

local SpinConn, SpinAngle = nil, 0

local function EnableSpin()
    SpinConn = RunService.Heartbeat:Connect(function()
        if not Config.SpinBot.Enabled then return end
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        SpinAngle = (SpinAngle + Config.SpinBot.Speed) % 360
        root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, math.rad(SpinAngle), 0)
    end)
end

local function DisableSpin()
    if SpinConn then SpinConn:Disconnect() SpinConn = nil end
end

