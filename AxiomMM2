-- ══════════════════════════════════════
--              UTILITIES
-- ══════════════════════════════════════
local function GetRoot(player)
    local c = player and player.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid(player)
    local c = player and player.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function NormalizeRole(raw)
    local r = tostring(raw):lower()
    if r:find("murder") or r:find("killer") then return "Murder"   end
    if r:find("sheriff")                     then return "Sheriff"  end
    if r:find("hero")                        then return "Hero"     end
    return "Innocent"
end

local RoleColors = {
    Murder   = Color3.fromRGB(255, 60,  60),
    Sheriff  = Color3.fromRGB(60,  140, 255),
    Hero     = Color3.fromRGB(255, 210, 0),
    Innocent = Color3.fromRGB(60,  255, 110),
}

local function GetRole(player)
    local sources = {
        player:FindFirstChild("Role"),
        player:FindFirstChild("mmRole"),
        player:FindFirstChild("PlayerRole"),
    }
    local ls = player:FindFirstChild("leaderstats")
    if ls then
        table.insert(sources, ls:FindFirstChild("Role"))
        table.insert(sources, ls:FindFirstChild("role"))
    end
    for _, v in ipairs(sources) do
        if v and v.Value and v.Value ~= "" then
            return NormalizeRole(v.Value)
        end
    end
    return "Innocent"
end

-- ══════════════════════════════════════
--              ESP SYSTEM
-- ══════════════════════════════════════
local ESPObjects = {}

local function NewLine()
    local l = Drawing.new("Line")
    l.Thickness = 1
    l.Visible   = false
    l.ZIndex    = 3
    return l
end

local function NewText(size)
    local t = Drawing.new("Text")
    t.Size    = size or 11
    t.Center  = true
    t.Outline = true
    t.Visible = false
    t.ZIndex  = 4
    return t
end

local function BuildESP(player)
    if player == LocalPlayer then return end
    ESPObjects[player] = {
        L1 = NewLine(), L2 = NewLine(),
        L3 = NewLine(), L4 = NewLine(),
        Name = NewText(12),
        Role = NewText(11),
        Dist = NewText(10),
    }
end

local function DestroyESP(player)
    local t = ESPObjects[player]
    if not t then return end
    for _, d in pairs(t) do d:Remove() end
    ESPObjects[player] = nil
end

local function HideAll(t)
    for _, d in pairs(t) do d.Visible = false end
end

local function ToScreen(pos)
    local s, depth = Camera:WorldToScreenPoint(pos)
    return Vector2.new(s.X, s.Y), depth, depth > 0
end

local function GetBBox(char)
    local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
    local anyOnScreen = false

    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            local s, d, on = ToScreen(p.Position)
            if on and d > 0 then
                anyOnScreen = true
                if s.X < minX then minX = s.X end
                if s.Y < minY then minY = s.Y end
                if s.X > maxX then maxX = s.X end
                if s.Y > maxY then maxY = s.Y end
            end
        end
    end

    if not anyOnScreen then return nil end
    local pad = 3
    return minX - pad, minY - pad, maxX + pad, maxY + pad
end

local function UpdateESP()
    for player, t in pairs(ESPObjects) do
        if not Config.ESP.Enabled then HideAll(t) continue end

        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")

        if not (char and root and hum and hum.Health > 0) then
            HideAll(t) continue
        end

        local lRoot = GetRoot(LocalPlayer)
        local dist  = lRoot and (root.Position - lRoot.Position).Magnitude or 0

        if dist > Config.ESP.MaxDistance then HideAll(t) continue end

        local x1, y1, x2, y2 = GetBBox(char)
        if not x1 then HideAll(t) continue end

        local role  = GetRole(player)
        local color = RoleColors[role] or RoleColors.Innocent

        t.L1.From = Vector2.new(x1,y1) t.L1.To = Vector2.new(x2,y1)
        t.L2.From = Vector2.new(x2,y1) t.L2.To = Vector2.new(x2,y2)
        t.L3.From = Vector2.new(x2,y2) t.L3.To = Vector2.new(x1,y2)
        t.L4.From = Vector2.new(x1,y2) t.L4.To = Vector2.new(x1,y1)
        for i = 1, 4 do
            t["L"..i].Color   = color
            t["L"..i].Visible = true
        end

        t.Name.Text     = player.DisplayName
        t.Name.Position = Vector2.new((x1+x2)/2, y1 - 14)
        t.Name.Color    = color
        t.Name.Visible  = true

        t.Role.Text     = "["..role.."]"
        t.Role.Position = Vector2.new((x1+x2)/2, y2 + 2)
        t.Role.Color    = color
        t.Role.Visible  = true

        t.Dist.Text     = string.format("%.0fm", dist)
        t.Dist.Position = Vector2.new((x1+x2)/2, y2 + 14)
        t.Dist.Color    = Color3.fromRGB(200, 200, 200)
        t.Dist.Visible  = true
    end
end

for _, p in ipairs(Players:GetPlayers()) do BuildESP(p) end
Players.PlayerAdded:Connect(BuildESP)
Players.PlayerRemoving:Connect(DestroyESP)

