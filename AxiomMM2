    Murder   = Color3.fromRGB(255, 50,  50),
    Sheriff  = Color3.fromRGB(50,  140, 255),
    Hero     = Color3.fromRGB(255, 210, 0),
    Innocent = Color3.fromRGB(50,  220, 100),
}

local function GetRoleByInventory(player)
    local containers = {}
    if player.Character then table.insert(containers, player.Character) end
    local bp = player:FindFirstChildOfClass("Backpack")
    if bp then table.insert(containers, bp) end
    for _, container in ipairs(containers) do
        for _, item in ipairs(container:GetChildren()) do
            local name = item.Name:lower()
            if name:find("knife") or name:find("blade") or name:find("murder") then return "Murder" end
            if name:find("gun") or name:find("sheriff") or name:find("pistol") then return "Sheriff" end
            if name:find("hero") then return "Hero" end
        end
    end
    return "Innocent"
end

local ESPObjects = {}

local function NewLine()
    local l = Drawing.new("Line")
    l.Thickness = 1.2
    l.Visible   = false
    l.ZIndex    = 3
    return l
end

local function NewText(size)
    local t = Drawing.new("Text")
    t.Size    = size or 11
    t.Center  = true
    t.Outline = true
    t.Visible = false
    t.ZIndex  = 4
    return t
end

local function BuildESP(player)
    if player == LocalPlayer then return end
    ESPObjects[player] = {
        L1=NewLine(), L2=NewLine(), L3=NewLine(), L4=NewLine(),
        Name=NewText(12), Role=NewText(11), Dist=NewText(10),
    }
end

local function DestroyESP(player)
    local t = ESPObjects[player]
    if not t then return end
    for _, d in pairs(t) do d:Remove() end
    ESPObjects[player] = nil
end

local function HideAll(t)
    for _, d in pairs(t) do d.Visible = false end
end

local function GetBBox(char)
    local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
    local hit = false
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            local s, d = Camera:WorldToScreenPoint(p.Position)
            if d > 0 then
                hit = true
                if s.X < minX then minX = s.X end
                if s.Y < minY then minY = s.Y end
                if s.X > maxX then maxX = s.X end
                if s.Y > maxY then maxY = s.Y end
            end
        end
    end
    if not hit then return nil end
    return minX-4, minY-4, maxX+4, maxY+4
end

local function UpdateESP()
    for player, t in pairs(ESPObjects) do
        if not Config.ESP.Enabled then HideAll(t) continue end
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not (char and root and hum and hum.Health > 0) then HideAll(t) continue end
        local lRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local dist  = lRoot and (root.Position - lRoot.Position).Magnitude or 0
        if dist > Config.ESP.MaxDistance then HideAll(t) continue end
        local x1, y1, x2, y2 = GetBBox(char)
        if not x1 then HideAll(t) continue end
        local role  = GetRoleByInventory(player)
        local color = RoleColors[role]
        local cx    = (x1+x2)/2
        t.L1.From=Vector2.new(x1,y1) t.L1.To=Vector2.new(x2,y1)
        t.L2.From=Vector2.new(x2,y1) t.L2.To=Vector2.new(x2,y2)
        t.L3.From=Vector2.new(x2,y2) t.L3.To=Vector2.new(x1,y2)
        t.L4.From=Vector2.new(x1,y2) t.L4.To=Vector2.new(x1,y1)
        for i=1,4 do t["L"..i].Color=color t["L"..i].Visible=true end
        t.Name.Text=player.DisplayName t.Name.Position=Vector2.new(cx,y1-14)
        t.Name.Color=color t.Name.Visible=true
        t.Role.Text="["..role.."]" t.Role.Position=Vector2.new(cx,y2+2)
        t.Role.Color=color t.Role.Visible=true
        t.Dist.Text=string.format("%.0fm",dist) t.Dist.Position=Vector2.new(cx,y2+14)
        t.Dist.Color=Color3.fromRGB(190,190,190) t.Dist.Visible=true
    end
end

