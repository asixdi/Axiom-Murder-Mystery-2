-- ══════════════════════════════════════
--              UTILITIES
-- ══════════════════════════════════════
local function GetRoot(player)
    local c = player and player.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid(player)
    local c = player and player.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

-- MM2 role detection — checks multiple possible locations
local function GetRole(player)
    -- Method 1: leaderstats
    local ls = player:FindFirstChild("leaderstats")
    if ls then
        local r = ls:FindFirstChild("Role") or ls:FindFirstChild("role")
        if r then return tostring(r.Value) end
    end
    -- Method 2: direct StringValue children
    for _, v in ipairs(player:GetChildren()) do
        local n = v.Name:lower()
        if n == "role" or n == "mmrole" or n == "playerrole" then
            return tostring(v.Value)
        end
    end
    -- Method 3: scan character tags
    local char = player.Character
    if char then
        for _, v in ipairs(char:GetChildren()) do
            local n = v.Name:lower()
            if n:find("murder") then return "Murder" end
            if n:find("sheriff") then return "Sheriff" end
            if n:find("hero") then return "Hero" end
        end
    end
    return "Innocent"
end

local function NormalizeRole(raw)
    local r = tostring(raw):lower()
    if r:find("murder") or r:find("killer") then return "Murder"   end
    if r:find("sheriff")                     then return "Sheriff"  end
    if r:find("hero")                        then return "Hero"     end
    if r:find("innocent") or r == ""         then return "Innocent" end
    return "Unknown"
end

local function RoleColor(role)
    return Config.ESP.Colors[role] or Config.ESP.Colors.Unknown
end

-- ══════════════════════════════════════
--              ESP SYSTEM
-- ══════════════════════════════════════
local ESPObjects = {}

local function NewDrawing(type, props)
    local d = Drawing.new(type)
    for k, v in pairs(props) do d[k] = v end
    return d
end

local function BuildESP(player)
    if player == LocalPlayer then return end
    local t = {}

    -- 4 box lines
    for i = 1, 4 do
        t["L"..i] = NewDrawing("Line", {
            Thickness = Config.ESP.BoxThickness,
            Color     = Color3.fromRGB(255,255,255),
            Visible   = false,
            ZIndex    = 4,
        })
    end

    t.Name = NewDrawing("Text", {
        Size    = Config.ESP.TextSize,
        Center  = true,
        Outline = true,
        Color   = Color3.fromRGB(255,255,255),
        Visible = false,
        ZIndex  = 5,
    })

    t.Role = NewDrawing("Text", {
        Size    = Config.ESP.TextSize,
        Center  = true,
        Outline = true,
        Color   = Color3.fromRGB(255,255,255),
        Visible = false,
        ZIndex  = 5,
    })

    t.Dist = NewDrawing("Text", {
        Size    = Config.ESP.TextSize - 1,
        Center  = true,
        Outline = true,
        Color   = Color3.fromRGB(200,200,200),
        Visible = false,
        ZIndex  = 5,
    })

    ESPObjects[player] = t
end

local function DestroyESP(player)
    if ESPObjects[player] then
        for _, d in pairs(ESPObjects[player]) do d:Remove() end
        ESPObjects[player] = nil
    end
end

local function HideESP(t)
    for _, d in pairs(t) do d.Visible = false end
end

local function UpdateESP()
    for player, t in pairs(ESPObjects) do
        if not Config.ESP.Enabled or player == LocalPlayer then
            HideESP(t) continue
        end

        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")

        if not (char and root and hum and hum.Health > 0) then
            HideESP(t) continue
        end

        local localRoot = GetRoot(LocalPlayer)
        local dist = localRoot and (root.Position - localRoot.Position).Magnitude or 0

        if dist > Config.ESP.MaxDistance then
            HideESP(t) continue
        end

        local screenPos, depth, onScreen = Camera:WorldToViewportPoint(root.Position)
        if not onScreen or depth <= 0 then HideESP(t) continue end

        local pos2D = Vector2.new(screenPos.X, screenPos.Y)

        -- tighter scale
        local scale = 1 / depth * 400
        local bW    = scale * 2
        local bH    = scale * 6

        local x1 = pos2D.X - bW / 2
        local y1 = pos2D.Y - bH / 2
        local x2 = pos2D.X + bW / 2
        local y2 = pos2D.Y + bH / 2

        local role  = NormalizeRole(GetRole(player))
        local color = RoleColor(role)

        -- Box
        local corners = {
            {Vector2.new(x1,y1), Vector2.new(x2,y1)},
            {Vector2.new(x2,y1), Vector2.new(x2,y2)},
            {Vector2.new(x2,y2), Vector2.new(x1,y2)},
            {Vector2.new(x1,y2), Vector2.new(x1,y1)},
        }
        for i = 1, 4 do
            t["L"..i].From    = corners[i][1]
            t["L"..i].To      = corners[i][2]
            t["L"..i].Color   = color
            t["L"..i].Visible = true
        end

        -- Name
        t.Name.Text     = player.DisplayName
        t.Name.Position = Vector2.new(pos2D.X, y1 - 14)
        t.Name.Color    = color
        t.Name.Visible  = true

        -- Role label
        t.Role.Text     = "["..role.."]"
        t.Role.Position = Vector2.new(pos2D.X, y2 + 2)
        t.Role.Color    = color
        t.Role.Visible  = true

        -- Distance
        t.Dist.Text     = string.format("%.0fm", dist)
        t.Dist.Position = Vector2.new(pos2D.X, y2 + 13)
        t.Dist.Visible  = true
    end
end

for _, p in ipairs(Players:GetPlayers()) do BuildESP(p) end
Players.PlayerAdded:Connect(BuildESP)
Players.PlayerRemoving:Connect(DestroyESP)

