local function CreateTab(name, icon)
    local btn = Instance.new("TextButton")
    btn.Size             = UDim2.new(0,108,1,0)
    btn.BackgroundColor3 = NL.Panel
    btn.BorderSizePixel  = 0
    btn.Text             = icon.." "..name
    btn.TextColor3       = NL.SubText
    btn.Font             = Enum.Font.GothamSemibold
    btn.TextSize         = 12
    btn.Parent           = TabBar
    local ind = Instance.new("Frame", btn)
    ind.Size             = UDim2.new(1,0,0,2)
    ind.Position         = UDim2.new(0,0,1,-2)
    ind.BackgroundColor3 = NL.Accent
    ind.BorderSizePixel  = 0
    ind.Visible          = false
    local page = Instance.new("ScrollingFrame")
    page.Size                = UDim2.new(1,0,1,0)
    page.BackgroundTransparency = 1
    page.BorderSizePixel     = 0
    page.ScrollBarThickness  = 3
    page.ScrollBarImageColor3= NL.Accent
    page.Visible             = false
    page.Parent              = Content
    local pl = Instance.new("UIListLayout", page)
    pl.Padding   = UDim.new(0,4)
    pl.SortOrder = Enum.SortOrder.LayoutOrder
    local pp = Instance.new("UIPadding", page)
    pp.PaddingTop=UDim.new(0,8) pp.PaddingLeft=UDim.new(0,10)
    pp.PaddingRight=UDim.new(0,10) pp.PaddingBottom=UDim.new(0,8)
    pl:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        page.CanvasSize = UDim2.new(0,0,0,pl.AbsoluteContentSize.Y+16)
    end)
    local tab = {Btn=btn, Page=page, Ind=ind}
    table.insert(Tabs, tab)
    btn.MouseButton1Click:Connect(function()
        if ActiveTab then
            ActiveTab.Page.Visible=false
            ActiveTab.Ind.Visible=false
            ActiveTab.Btn.TextColor3=NL.SubText
        end
        ActiveTab=tab
        page.Visible=true ind.Visible=true
        btn.TextColor3=Color3.fromRGB(255,255,255)
    end)
    return page
end

