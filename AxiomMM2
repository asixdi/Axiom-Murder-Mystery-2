local function CreateToggle(label, configTable, key, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.BackgroundColor3 = configTable[key]
        and Color3.fromRGB(255,50,50)
        or Color3.fromRGB(30,30,30)
    btn.BorderSizePixel = 0
    btn.Text = label .. (configTable[key] and "  [ON]" or "  [OFF]")
    btn.TextColor3 = Color3.fromRGB(255,255,255)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 13
    btn.Parent = MainFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    btn.MouseButton1Click:Connect(function()
        configTable[key] = not configTable[key]
        btn.Text = label .. (configTable[key] and "  [ON]" or "  [OFF]")
        btn.BackgroundColor3 = configTable[key]
            and Color3.fromRGB(255,50,50)
            or Color3.fromRGB(30,30,30)
        if callback then callback(configTable[key]) end
    end)

    return btn
end

